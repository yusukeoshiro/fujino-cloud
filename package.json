{
	"name": "fujino-cloud",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:prod": "vite dev --mode=production",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch & tsc --noEmit --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"verify": "npm run check && npm run lint && npm run test -- --browser.headless"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.36.0",
		"@sveltejs/adapter-node": "^5.3.2",
		"@sveltejs/kit": "<=2.21.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.1.13",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/luxon": "^3.7.1",
		"@types/node": "^20",
		"@vitest/browser": "^3.2.4",
		"csv-parse": "^6.1.0",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"firebase": "^12.4.0",
		"globals": "^16.4.0",
		"houdini": "^1.5.10",
		"houdini-svelte": "^2.1.20",
		"jsonwebtoken": "^9.0.2",
		"luxon": "^3.7.2",
		"playwright": "^1.55.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"sass-embedded": "^1.93.2",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.1",
		"vite": "^6.2.6",
		"vitest": "^3.0.0",
		"vitest-browser-svelte": "^1.1.0"
	},
	"dependencies": {
		"firebase-admin": "^13.5.0"
	}
}
